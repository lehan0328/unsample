# Unsample Observability Stack
# Generated by: unsample init
#
# Starts the trace backend for Unsample debug tracing:
#   - OTel Collector (receives traces, routes debug vs production)
#   - Grafana Tempo (trace storage)
#   - Grafana (trace viewer UI)
#
# Usage:
#   docker compose -f .unsample/docker-compose.yaml up -d
#   docker compose -f .unsample/docker-compose.yaml down -v
#
# Ports:
#   4317 - OTLP gRPC (point your services here)
#   4318 - OTLP HTTP
#   3000 - Grafana UI
#   3200 - Tempo HTTP API

services:

  otel-collector:
    image: otel/opentelemetry-collector-contrib:0.158.0
    command: ["--config", "/etc/otel/config.yaml"]
    volumes:
      - ./otel-collector-config.yaml:/etc/otel/config.yaml:ro
    ports:
      - "4317:4317"
      - "4318:4318"
    depends_on:
      tempo:
        condition: service_started

  tempo:
    image: grafana/tempo:2.6.1
    command: ["-config.file=/etc/tempo/config.yaml"]
    volumes:
      - ./tempo-config.yaml:/etc/tempo/config.yaml:ro
      - tempo-data:/var/tempo
    ports:
      - "3200:3200"

  grafana:
    image: grafana/grafana:11.6.0
    environment:
      - GF_AUTH_ANONYMOUS_ENABLED=true
      - GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
      - GF_AUTH_DISABLE_LOGIN_FORM=true
    volumes:
      - ./grafana-datasources.yaml:/etc/grafana/provisioning/datasources/datasources.yaml:ro
    ports:
      - "3000:3000"
    depends_on:
      tempo:
        condition: service_started

volumes:
  tempo-data:
