# Unsample CLI Configuration
# Generated by: unsample init
#
# This file configures the unsample CLI. Set UNSAMPLE_SECRET as an
# environment variable in each service that uses the SDK middleware.

# Shared HMAC secret for debug token signing/verification.
# All services and the CLI must use the same secret.
secret: {{.Secret}}

# Grafana URL for trace deep links.
grafana_url: http://localhost:3000

# Tempo query endpoint for trace polling.
tempo_url: http://localhost:3200
